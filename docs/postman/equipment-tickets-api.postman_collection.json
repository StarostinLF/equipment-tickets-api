{
  "info": {
    "name": "Equipment Maintenance Tickets API",
    "description": "Коллекция для сервиса учёта оборудования и заявок на его обслуживание. Запросы в папке Equipment рассчитаны на последовательный запуск (Collection Runner): создание сохраняет {{equipmentId}}, остальные запросы его переиспользуют, удаление — последним.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "equipmentId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Тело содержит data.status = ok', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Equipment",
      "item": [
        {
          "name": "Создать оборудование",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/equipment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Турбина №1\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"SN-001\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.62 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2023-05-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 201', () => pm.response.to.have.status(201));",
                  "pm.test('Есть заголовок Location', () => pm.response.to.have.header('Location'));",
                  "const body = pm.response.json();",
                  "pm.test('В ответе есть id', () => pm.expect(body.data.id).to.be.a('string'));",
                  "pm.collectionVariables.set('equipmentId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Список оборудования",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/equipment?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('data — массив', () => pm.expect(body.data).to.be.an('array'));",
                  "pm.test('meta содержит total/page/limit', () => {",
                  "  pm.expect(body.meta).to.have.all.keys('total', 'page', 'limit');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Карточка оборудования",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/equipment/{{equipmentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('id совпадает', () => {",
                  "  pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('equipmentId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Обновление статуса (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/equipment/{{equipmentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"maintenance\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Статус оборудования обновлён', () => {",
                  "  pm.expect(pm.response.json().data.status).to.eql('maintenance');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Прогноз погоды",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/equipment/{{equipmentId}}/weather"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 (успех) или 502 (внешнее API недоступно)', () => {",
                  "  pm.expect([200, 502]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Есть признак пригодности окна для работ', () => {",
                  "    pm.expect(pm.response.json().data).to.have.property('outdoorWorkSuitable');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Создание — дубль serialNumber (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/equipment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Турбина-дубль\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"SN-001\",\n  \"location\": { \"lat\": 1, \"lon\": 1 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2023-05-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 409', () => pm.response.to.have.status(409));",
                  "pm.test('code = CONFLICT', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('CONFLICT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Создание — невалидные данные (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/equipment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"аб\",\n  \"type\": \"bad_type\",\n  \"serialNumber\": \"\",\n  \"location\": { \"lat\": 999, \"lon\": 1 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2099-01-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 422', () => pm.response.to.have.status(422));",
                  "const body = pm.response.json();",
                  "pm.test('code = VALIDATION_ERROR', () => pm.expect(body.error.code).to.eql('VALIDATION_ERROR'));",
                  "pm.test('details не пустой', () => pm.expect(body.error.details.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Несуществующий id (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/equipment/00000000-0000-4000-8000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 404', () => pm.response.to.have.status(404));",
                  "pm.test('code = NOT_FOUND', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Удаление оборудования",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/equipment/{{equipmentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
