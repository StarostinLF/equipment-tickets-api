{
  "info": {
    "name": "Equipment Maintenance Tickets API",
    "description": "Коллекция для сервиса учёта оборудования и заявок на его обслуживание.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Тело содержит data.status = ok', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
