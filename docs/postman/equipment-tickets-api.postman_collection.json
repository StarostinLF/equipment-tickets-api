{
  "info": {
    "name": "Equipment Maintenance Tickets API",
    "description": "Коллекция для сервиса учёта оборудования и заявок на его обслуживание. Папки рассчитаны на последовательный запуск (Collection Runner): Equipment создаёт {{equipmentId}} и оставляет оборудование неудалённым, Requests создаёт {{requestId}}, прогоняет переходы статуса и в конце удаляет и заявку, и оборудование.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "equipmentId", "value": "" },
    { "key": "requestId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Тело содержит data.status = ok', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Equipment",
      "item": [
        {
          "name": "Создать оборудование",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/equipment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Турбина №1\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"SN-001\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.62 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2023-05-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 201', () => pm.response.to.have.status(201));",
                  "pm.test('Есть заголовок Location', () => pm.response.to.have.header('Location'));",
                  "const body = pm.response.json();",
                  "pm.test('В ответе есть id', () => pm.expect(body.data.id).to.be.a('string'));",
                  "pm.collectionVariables.set('equipmentId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Список оборудования",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/equipment?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('data — массив', () => pm.expect(body.data).to.be.an('array'));",
                  "pm.test('meta содержит total/page/limit', () => {",
                  "  pm.expect(body.meta).to.have.all.keys('total', 'page', 'limit');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Карточка оборудования",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/equipment/{{equipmentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('id совпадает', () => {",
                  "  pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('equipmentId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Обновление статуса (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/equipment/{{equipmentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"maintenance\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Статус оборудования обновлён', () => {",
                  "  pm.expect(pm.response.json().data.status).to.eql('maintenance');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Обновление пустым телом (422)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/equipment/{{equipmentId}}",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 422', () => pm.response.to.have.status(422));",
                  "pm.test('code = VALIDATION_ERROR', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Прогноз погоды",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/equipment/{{equipmentId}}/weather"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 (успех) или 502 (внешнее API недоступно)', () => {",
                  "  pm.expect([200, 502]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Есть признак пригодности окна для работ', () => {",
                  "    pm.expect(pm.response.json().data).to.have.property('outdoorWorkSuitable');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Создание — дубль serialNumber (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/equipment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Турбина-дубль\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"SN-001\",\n  \"location\": { \"lat\": 1, \"lon\": 1 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2023-05-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 409', () => pm.response.to.have.status(409));",
                  "pm.test('code = CONFLICT', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('CONFLICT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Создание — невалидные данные (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/equipment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"аб\",\n  \"type\": \"bad_type\",\n  \"serialNumber\": \"\",\n  \"location\": { \"lat\": 999, \"lon\": 1 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2099-01-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 422', () => pm.response.to.have.status(422));",
                  "const body = pm.response.json();",
                  "pm.test('code = VALIDATION_ERROR', () => pm.expect(body.error.code).to.eql('VALIDATION_ERROR'));",
                  "pm.test('details не пустой', () => pm.expect(body.error.details.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Несуществующий id (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/equipment/00000000-0000-4000-8000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 404', () => pm.response.to.have.status(404));",
                  "pm.test('code = NOT_FOUND', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "Создание — несуществующее оборудование (404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipmentId\": \"00000000-0000-4000-8000-000000000000\",\n  \"title\": \"Check turbine\",\n  \"priority\": \"medium\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 404', () => pm.response.to.have.status(404));",
                  "pm.test('code = NOT_FOUND', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Создать заявку",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"title\": \"Check turbine vibration\",\n  \"description\": \"Routine check\",\n  \"priority\": \"medium\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Статус заявки — new', () => pm.expect(body.data.status).to.eql('new'));",
                  "pm.collectionVariables.set('requestId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Список заявок",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/requests?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('data — массив', () => pm.expect(body.data).to.be.an('array'));",
                  "pm.test('meta содержит total/page/limit', () => {",
                  "  pm.expect(body.meta).to.have.all.keys('total', 'page', 'limit');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Карточка заявки",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/requests/{{requestId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('id совпадает', () => {",
                  "  pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('requestId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Редактирование полей (PATCH) — служебные поля игнорируются",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/{{requestId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Check turbine vibration urgently\",\n  \"status\": \"done\",\n  \"id\": \"hacked\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('title обновлён', () => pm.expect(body.data.title).to.eql('Check turbine vibration urgently'));",
                  "pm.test('status не изменился через общий PATCH', () => pm.expect(body.data.status).to.eql('new'));",
                  "pm.test('id не изменился', () => pm.expect(body.data.id).to.eql(pm.collectionVariables.get('requestId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Недопустимый переход статуса new -> done (409)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/{{requestId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"done\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 409', () => pm.response.to.have.status(409));",
                  "pm.test('code = CONFLICT', () => pm.expect(pm.response.json().error.code).to.eql('CONFLICT'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Допустимый переход new -> in_progress",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/{{requestId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"in_progress\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Статус обновлён на in_progress', () => {",
                  "  pm.expect(pm.response.json().data.status).to.eql('in_progress');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Заявки по оборудованию (вложенный ресурс)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/equipment/{{equipmentId}}/requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Заявка присутствует в списке', () => {",
                  "  pm.expect(body.data.some((item) => item.id === pm.collectionVariables.get('requestId'))).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Удаление оборудования с открытой заявкой (409)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/equipment/{{equipmentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 409', () => pm.response.to.have.status(409));",
                  "pm.test('code = CONFLICT', () => pm.expect(pm.response.json().error.code).to.eql('CONFLICT'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Переход in_progress -> done",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/requests/{{requestId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"done\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('Статус обновлён на done', () => {",
                  "  pm.expect(pm.response.json().data.status).to.eql('done');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Удаление заявки",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/requests/{{requestId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Удаление оборудования (заявок больше нет)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/equipment/{{equipmentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
