# Порт HTTP-сервера
PORT=3000

# Режим работы: development | production | test
NODE_ENV=development

# Разрешённые источники для CORS через запятую, без пробелов
# Пример: http://localhost:5173,https://example.com
CORS_ORIGINS=http://localhost:5173

# Ограничение частоты запросов на маршруты /api
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Внешнее погодное API (Open-Meteo, ключ не требуется)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Таймаут запросов к внешним сервисам, мс
REQUEST_TIMEOUT_MS=5000

# Подключение к PostgreSQL (см. docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=equipment_tickets
DB_USER=postgres
DB_PASSWORD=postgres

# Пул соединений Sequelize
DB_POOL_MIN=0
DB_POOL_MAX=5
