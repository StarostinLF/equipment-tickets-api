{
  "name": "equipment-tickets-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API для учёта оборудования и заявок на его обслуживание",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env node_modules/sequelize-cli/lib/sequelize db:migrate",
    "db:migrate:undo": "node --env-file-if-exists=.env node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
    "db:migrate:undo:all": "node --env-file-if-exists=.env node_modules/sequelize-cli/lib/sequelize db:migrate:undo:all",
    "db:seed:all": "node --env-file-if-exists=.env node_modules/sequelize-cli/lib/sequelize db:seed:all",
    "db:seed:undo:all": "node --env-file-if-exists=.env node_modules/sequelize-cli/lib/sequelize db:seed:undo:all"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sequelize": "^6.37.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "sequelize-cli": "^6.6.5"
  }
}
